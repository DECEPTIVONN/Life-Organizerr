rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper validation functions for security & anti-DoS
    function isValidSyncKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 128;
    }

    function isReasonablePayload() {
      // Limit field payload sizes to prevent database bloating DoS attacks
      return request.resource.data.keys().size() <= 100;
    }

    match /sync_profiles/{syncKey} {
      allow read: if isValidSyncKey(syncKey);
      allow create, update: if isValidSyncKey(syncKey);
      allow delete: if isValidSyncKey(syncKey);
    }

    match /connected_devices/{accountKey} {
      allow read: if isValidSyncKey(accountKey);
      allow create, update: if isValidSyncKey(accountKey);
      allow delete: if isValidSyncKey(accountKey);
    }

    match /user_alarms/{syncKey} {
      allow read, write: if isValidSyncKey(syncKey);
    }

    match /web_push_subscriptions/{subId} {
      allow read, write: if subId is string && subId.size() >= 3;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
